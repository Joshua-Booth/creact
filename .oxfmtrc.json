{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "embeddedLanguageFormatting": "auto",
  "htmlWhitespaceSensitivity": "css",
  "jsxSingleQuote": false,
  "printWidth": 80,
  "proseWrap": "preserve",
  "quoteProps": "as-needed",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "useTabs": false,
  "vueIndentScriptAndStyle": false,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "functions": ["cn", "cva"]
  },
  "sortImports": {
    "newlinesBetween": false,
    "customGroups": [
      {
        "groupName": "internal-types",
        "elementNamePattern": ["@/**"],
        "modifiers": ["type"]
      },
      {
        "groupName": "scoped-types",
        "elementNamePattern": ["@*/**"],
        "modifiers": ["type"]
      },
      {
        "groupName": "react",
        "elementNamePattern": ["react"],
        "modifiers": ["value"]
      },
      {
        "groupName": "react-dom",
        "elementNamePattern": ["react-dom", "react-dom/**"],
        "modifiers": ["value"]
      },
      {
        "groupName": "react-router",
        "elementNamePattern": ["react-router", "react-router/**"],
        "modifiers": ["value"]
      },
      {
        "groupName": "react-hook-form",
        "elementNamePattern": ["react-hook-form"],
        "modifiers": ["value"]
      },
      {
        "groupName": "react-i18next",
        "elementNamePattern": ["react-i18next"],
        "modifiers": ["value"]
      },
      {
        "groupName": "storybook-alias",
        "elementNamePattern": ["@/storybook", "@/storybook/**"]
      },
      {
        "groupName": "fsd-app",
        "elementNamePattern": ["@/app", "@/app/**"]
      },
      {
        "groupName": "fsd-pages",
        "elementNamePattern": ["@/pages", "@/pages/**"]
      },
      {
        "groupName": "fsd-widgets",
        "elementNamePattern": ["@/widgets", "@/widgets/**"]
      },
      {
        "groupName": "fsd-features",
        "elementNamePattern": ["@/features", "@/features/**"]
      },
      {
        "groupName": "fsd-entities",
        "elementNamePattern": ["@/entities", "@/entities/**"]
      },
      {
        "groupName": "shared-api",
        "elementNamePattern": ["@/shared/api", "@/shared/api/**"]
      },
      {
        "groupName": "shared-config",
        "elementNamePattern": ["@/shared/config", "@/shared/config/**"]
      },
      {
        "groupName": "shared-model",
        "elementNamePattern": ["@/shared/model", "@/shared/model/**"]
      },
      {
        "groupName": "shared-lib",
        "elementNamePattern": ["@/shared/lib", "@/shared/lib/**"]
      },
      {
        "groupName": "shared-i18n",
        "elementNamePattern": ["@/shared/i18n", "@/shared/i18n/**"]
      },
      {
        "groupName": "shared-ui",
        "elementNamePattern": ["@/shared/ui", "@/shared/ui/**"]
      },
      {
        "groupName": "shared-assets",
        "elementNamePattern": ["@/shared/assets", "@/shared/assets/**"]
      }
    ],
    "groups": [
      ["scoped-types", "type-builtin", "value-builtin"],
      {
        "newlinesBetween": true
      },
      "react",
      "react-dom",
      "react-router",
      "react-hook-form",
      "react-i18next",
      {
        "newlinesBetween": true
      },
      "type-external",
      ["value-external", "storybook-alias"],
      {
        "newlinesBetween": true
      },
      "internal-types",
      "fsd-app",
      "fsd-pages",
      "fsd-widgets",
      "fsd-features",
      "fsd-entities",
      "shared-api",
      "shared-config",
      "shared-model",
      "shared-lib",
      "shared-i18n",
      "shared-ui",
      "shared-assets",
      "value-internal",
      {
        "newlinesBetween": true
      },
      ["type-parent", "type-sibling", "type-index"],
      ["value-parent", "value-sibling", "value-index"],
      "unknown"
    ]
  },
  "ignorePatterns": [
    "**/*.md",
    "**/*.toml",
    "**/*.hbs",
    ".vscode/",
    "pnpm-lock.yaml",
    "public/mockServiceWorker.js",
    ".claude/"
  ]
}
