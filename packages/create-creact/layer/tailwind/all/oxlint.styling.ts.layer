import type { OxlintConfig } from "{{oxlint}}";
import betterTailwindcss from "eslint-plugin-better-tailwindcss";
import designSystem from "outtrue/configs/recommended.json" with { type: "json" };

type Override = NonNullable<OxlintConfig["overrides"]>[number];
type Rules = NonNullable<Override["rules"]>;

const shadcnComponentsAsWritten: Override = {
  files: ["packages/ui/src/components/**"],
  rules: {
    "better-tailwindcss/no-unknown-classes": "off",
    "jsx-a11y/label-has-associated-control": "off",
    "jsx-a11y/click-events-have-key-events": "off",
    "jsx-a11y/no-noninteractive-element-interactions": "off",
    "design-system/no-important": "off",
    "design-system/no-raw-values": "off",
  },
};

const betterTStackTemplateAsWritten: Override = {
  files: ["apps/web/src/root.tsx", "apps/web/src/routes/_index.tsx"],
  rules: {
    "no-empty-pattern": "off",
    "typescript/strict-boolean-expressions": "off",
  },
};

const betterTStackClassesAsWritten: Override = {
  files: [
    "apps/web/src/components/mode-toggle.tsx",
    "apps/web/src/app/layout.tsx",
  ],
  rules: {
    "design-system/no-raw-values": "off",
    "design-system/no-template-classname": "off",
  },
};

const registryItemsAsWritten: Override = {
  files: ["apps/web/src/shared/ui/**/*.{ts,tsx}"],
  rules: {
    "jsdoc-js/require-param": "off",
    "jsdoc-js/require-param-description": "off",
    "jsdoc-js/require-returns": "off",
    "jsdoc-js/require-returns-description": "off",
  },
};

const registryMarkerClasses: Override = {
  files: ["apps/web/src/shared/**"],
  rules: {
    "better-tailwindcss/no-unknown-classes": [
      "warn",
      { ignore: ["^cn-", "^toaster$"] },
    ],
  },
};

export const styling = {
  settings: {
    "better-tailwindcss": { cwd: "apps/web", entryPoint: "src/index.css" },
    "design-system": { primitives: "packages/ui/src/components" },
  },
  overrides: [
    {
      files: ["**/*.tsx"],
      jsPlugins: ["eslint-plugin-better-tailwindcss"],
      rules: {
        ...betterTailwindcss.configs.recommended.rules,
        "better-tailwindcss/no-conflicting-classes": "error",
        "better-tailwindcss/no-duplicate-classes": "error",
        "better-tailwindcss/no-deprecated-classes": "error",
        "better-tailwindcss/no-unknown-classes": "warn",
        "better-tailwindcss/enforce-consistent-class-order": "off",
        "better-tailwindcss/enforce-consistent-line-wrapping": "off",
        "better-tailwindcss/enforce-canonical-classes": "warn",
        "better-tailwindcss/enforce-shorthand-classes": "warn",
      },
    },
    {
      files: ["**/*.tsx"],
      jsPlugins: designSystem.jsPlugins,
      rules: {
        ...(designSystem.rules as Rules),
        "design-system/known-tokens": [
          "error",
          {
            theme: [
              "packages/ui/src/styles/globals.css",
              "apps/web/src/index.css",
            ],
          },
        ],
      },
    },
    shadcnComponentsAsWritten,
    betterTStackTemplateAsWritten,
    betterTStackClassesAsWritten,
    registryItemsAsWritten,
    registryMarkerClasses,
  ],
} satisfies Pick<OxlintConfig, "settings" | "overrides">;
