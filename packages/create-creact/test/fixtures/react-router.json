{
  "bts": "create-better-t-stack@3.48.0",
  "package.json": {
    "name": "app",
    "private": true,
    "workspaces": ["apps/*", "packages/*"],
    "type": "module",
    "scripts": {
      "dev": "pnpm -r dev",
      "build": "pnpm -r --if-present build",
      "check-types": "pnpm -r check-types",
      "dev:web": "pnpm --filter web dev",
      "env:generate": "varlock codegen --path ./apps/web/",
      "postinstall": "varlock codegen --path ./apps/web/"
    },
    "dependencies": {
      "zod": "catalog:"
    },
    "devDependencies": {
      "@app/config": "workspace:*",
      "@types/node": "catalog:",
      "typescript": "catalog:",
      "varlock": "catalog:"
    },
    "packageManager": "pnpm@12.15.0"
  },
  "tsconfig.json": {
    "extends": "@app/config/tsconfig.base.json"
  },
  "packages/config/tsconfig.base.json": {
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
      "target": "ESNext",
      "module": "ESNext",
      "moduleResolution": "bundler",
      "lib": ["ESNext"],
      "verbatimModuleSyntax": true,
      "strict": true,
      "skipLibCheck": true,
      "resolveJsonModule": true,
      "allowSyntheticDefaultImports": true,
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "isolatedModules": true,
      "noUncheckedIndexedAccess": true,
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "noFallthroughCasesInSwitch": true,
      "types": ["node"]
    }
  },
  "apps/web/package.json": {
    "name": "web",
    "private": true,
    "type": "module",
    "scripts": {
      "build": "react-router build",
      "dev": "react-router dev",
      "start": "react-router-serve ./build/server/index.js",
      "check-types": "react-router typegen && tsc --noEmit",
      "env:generate": "varlock codegen"
    },
    "dependencies": {
      "@app/ui": "workspace:*",
      "@react-router/fs-routes": "^8.3.1",
      "@react-router/node": "^8.3.1",
      "@react-router/serve": "^8.3.1",
      "@varlock/vite-integration": "1.5.4",
      "isbot": "^5.2.2",
      "lucide-react": "catalog:",
      "next-themes": "catalog:",
      "react": "catalog:",
      "react-dom": "catalog:",
      "react-router": "^8.3.1",
      "sonner": "catalog:",
      "varlock": "catalog:",
      "zod": "catalog:"
    },
    "devDependencies": {
      "@app/config": "workspace:*",
      "@react-router/dev": "^8.3.1",
      "@tailwindcss/vite": "^4.3.3",
      "@types/node": "catalog:",
      "@types/react": "catalog:",
      "@types/react-dom": "catalog:",
      "tailwindcss": "catalog:",
      "typescript": "catalog:",
      "vite": "^8.2.2"
    }
  },
  "apps/web/tsconfig.json": {
    "include": [
      "**/*",
      "**/.server/**/*",
      "**/.client/**/*",
      ".react-router/types/**/*"
    ],
    "compilerOptions": {
      "lib": ["DOM", "DOM.Iterable", "ES2022"],
      "types": ["node", "vite/client"],
      "target": "ES2022",
      "module": "ES2022",
      "moduleResolution": "bundler",
      "jsx": "react-jsx",
      "rootDirs": [".", "./.react-router/types"],
      "paths": {
        "@/*": ["./src/*"],
        "@app/ui/*": ["../../packages/ui/src/*"]
      },
      "esModuleInterop": true,
      "verbatimModuleSyntax": true,
      "noEmit": true,
      "resolveJsonModule": true,
      "skipLibCheck": true,
      "strict": true
    }
  }
}
